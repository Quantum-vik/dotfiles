# Curated GNOME settings for this machine — generated by `dconf dump` on selected paths.
# Restore:  sed "s|@HOME@|$HOME|g" desktop.dconf | dconf load /
# Deliberately NOT included: /org/gnome/shell command-history, recent files, online accounts,
# window geometry, app state.

[org/gnome/desktop/interface]
clock-show-weekday=true
color-scheme='prefer-dark'
cursor-theme='WhiteSur-cursors'
document-font-name='Inter 10.5'
font-name='Inter 10.5'
gtk-theme='WhiteSur-Dark'
icon-theme='WhiteSur-dark'
show-battery-percentage=true

[org/gnome/desktop/peripherals/keyboard]
delay=uint32 225
numlock-state=false
repeat-interval=uint32 30

[org/gnome/desktop/peripherals/mouse]
natural-scroll=false
speed=0.0

[org/gnome/desktop/peripherals/touchpad]
click-method='fingers'
disable-while-typing=true
natural-scroll=true
speed=0.40000000000000002
tap-and-drag=true
tap-to-click=true
two-finger-scrolling-enabled=true

[org/gnome/desktop/input-sources]
sources=[('xkb', 'us'), ('xkb', 'in')]
xkb-options=@as []

[org/gnome/desktop/wm/keybindings]
move-to-workspace-left=['<Control><Shift>Left', '<Super><Shift>Page_Up', '<Control><Shift><Alt>Left']
move-to-workspace-right=['<Control><Shift>Right', '<Super><Shift>Page_Down', '<Control><Shift><Alt>Right']
switch-input-source=@as []
switch-input-source-backward=@as []
switch-to-workspace-left=['<Control>Left', '<Super>Page_Up', '<Control><Alt>Left']
switch-to-workspace-right=['<Control>Right', '<Super>Page_Down', '<Control><Alt>Right']

[org/gnome/desktop/wm/preferences]
action-double-click-titlebar='toggle-maximize'
action-middle-click-titlebar='minimize'
button-layout='close,minimize,maximize:'
num-workspaces=4
titlebar-font='Inter Bold 10.5'

[org/gnome/desktop/background]
picture-options='zoom'
picture-uri='file://@HOME@/.local/share/backgrounds/Sonoma/Sonoma-timed.xml'
picture-uri-dark='file://@HOME@/.local/share/backgrounds/Sonoma/Sonoma-timed.xml'

[org/gnome/desktop/screensaver]
picture-uri='file://@HOME@/.local/share/backgrounds/Sonoma/Sonoma-timed.xml'

[org/gnome/mutter]
dynamic-workspaces=false
edge-tiling=false
workspaces-only-on-primary=false

[org/gnome/mutter/keybindings]
toggle-tiled-left=@as []
toggle-tiled-right=@as []

[org/gnome/shell/keybindings]
screenshot=['<Shift><Super>3', '<Shift>Print']
show-screen-recording-ui=['<Shift><Super>6', '<Ctrl><Shift><Alt>R']
show-screenshot-ui=['<Shift><Super>4', '<Shift><Super>5', 'Print']
toggle-message-tray=['<Super>m']

[org/gnome/shell/extensions/dash-to-dock]
app-shift-hotkey-3=@as []
app-shift-hotkey-4=@as []
app-shift-hotkey-5=@as []
app-shift-hotkey-6=@as []
autohide=true
dash-max-icon-size=64
dock-fixed=false
dock-position='RIGHT'
intellihide=false

[org/gnome/shell/extensions/custom-hot-corners-extended/misc]
hot-corners-enabled=true
show-osd-monitor-indexes=false
supported-active-extensions=@as []

[org/gnome/shell/extensions/custom-hot-corners-extended/monitor-0-bottom-left-0]
action='show-applications'
fullscreen=true

[org/gnome/shell/extensions/custom-hot-corners-extended/monitor-0-bottom-right-0]
action='run-command'
command='zim --plugin quicknote'
fullscreen=true

[org/gnome/shell/extensions/custom-hot-corners-extended/monitor-0-top-left-0]
action='lock-screen'
fullscreen=true

[org/gnome/shell/extensions/custom-hot-corners-extended/monitor-0-top-right-0]
action='toggle-overview'
fullscreen=true

[org/gnome/shell/extensions/tiling-assistant]
active-window-hint-color='rgb(211,70,21)'
last-version-installed=46
overridden-settings={'org.gnome.mutter.edge-tiling': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-left': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-right': <@mb nothing>}
tiling-popup-all-workspace=true

[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Dark'

[org/gnome/shell/extensions/another-window-session-manager]
enable-restore-previous-session=true
restore-at-startup-without-asking=true

[org/gnome/shell/extensions/astra-monitor]
sensors-header-sensor1='{"service":"lm-sensors","path":["coretemp-isa-0000","Package id 0","temp1_input"]}'
sensors-header-sensor1-show=true
sensors-header-show=true

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/copyq/']
screensaver=['<Super>l']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/copyq]
binding='<Super>v'
command='copyq toggle'
name='CopyQ clipboard history'

[org/gnome/settings-daemon/plugins/color]
night-light-enabled=false
night-light-schedule-automatic=true

[org/gnome/terminal/legacy/profiles:]
default='b1dcc9dd-5262-4d8d-a863-c897e6d979b9'
list=['b1dcc9dd-5262-4d8d-a863-c897e6d979b9']

[org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9]
audible-bell=false
background-color='#1c1c21'
background-transparency-percent=12
bold-color-same-as-fg=true
cursor-background-color='#cbc3e3'
cursor-colors-set=true
cursor-foreground-color='#1c1c21'
cursor-shape='ibeam'
font='MesloLGS NF 12'
foreground-color='#e4e4e8'
highlight-background-color='#b4a7f5'
highlight-colors-set=true
highlight-foreground-color='#1c1c21'
palette=['#2a2a31', '#ff6b6b', '#69d58c', '#f5c26b', '#6aa7ff', '#b48cff', '#5fd7d7', '#c8c8d0', '#5c5c66', '#ff8787', '#8ce8a8', '#ffd68a', '#8fb8ff', '#cbb0ff', '#87e5e5', '#ffffff']
scrollback-lines=20000
use-system-font=false
use-theme-colors=false
use-transparent-background=false
visible-name='WhiteSur Dark'

[desktop/ibus/general/hotkey]
trigger=['Zenkaku_Hankaku', 'Alt+Kanji', 'Alt+grave', 'Hangul', 'Alt+Release+Alt_R']

[org/gnome/shell]
enabled-extensions=['custom-hot-corners-extended@G-dH.github.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'monitor@astraext.github.io', 'fan-mode@quantumvik', 'another-window-session-manager@gmail.com']
disabled-extensions=['Vitals@CoreCoding.com']
favorite-apps=['google-chrome.desktop', 'org.gnome.Nautilus.desktop', 'code.desktop', 'postman.desktop', 'auto-keka.desktop', 'com.rtosta.zapzap.desktop', 'com.github.IsmaelMartinez.teams_for_linux.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Snapshot.desktop']

