[user]
	name  = @WORK_NAME@
	email = @WORK_EMAIL@

[pull]
	rebase = true

[init]
	defaultBranch = main

[core]
	editor = code --wait

# Personal repos live under ~/WorkPersonal — override identity there so they
# stop getting the work email.
[includeIf "gitdir:~/WorkPersonal/"]
	path = ~/.gitconfig-personal

# dotfiles is a personal repo (github.com/Quantum-vik/dotfiles) but lives in $HOME,
# outside ~/WorkPersonal — scope it explicitly or it inherits the work identity.
[includeIf "gitdir:~/dotfiles/"]
	path = ~/.gitconfig-personal
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
