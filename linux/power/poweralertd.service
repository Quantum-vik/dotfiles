# Desktop notification when the charger is connected or disconnected.
# poweralertd 0.3.0 (https://sr.ht/~kennylevinsen/poweralertd), built by install.sh into ~/.local/bin:
# No -s: poweralertd only completes its session-bus handshake when it sends a notification, so with -s
# the idle connection is dropped and the first charger event crashes it ("Transport endpoint is not
# connected"). Without -s it shows the charger state once at login, which keeps the connection alive.
#   -S          only power supplies (skips Bluetooth headphones, mice, ...)
#   -i battery  skip battery charge/discharge/level messages; GNOME already warns about low battery
[Unit]
Description=Notify when the charger is connected or disconnected
Documentation=https://sr.ht/~kennylevinsen/poweralertd
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/poweralertd -S -i battery
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
