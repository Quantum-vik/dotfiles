<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Lets the person sitting at the laptop switch fan modes with no password prompt.
     Only /usr/local/sbin/fan-mode is covered, and it accepts only status|auto|quiet|max.
     Remote (SSH) and inactive sessions still need an admin password. -->
<policyconfig>
  <action id="local.fan-mode">
    <description>Change the laptop fan mode</description>
    <message>Authentication is required to change the fan mode</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/fan-mode</annotate>
  </action>
</policyconfig>
